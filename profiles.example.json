  {
    "name": "Media",
    "buttons": [
      {
        "label": "Previous",
        "icon": "|◀",
        "color": "#b4a0ff",
        "steps": [
          "tap PreviousTrack"
        ]
      },
      {
        "label": "Play / pause",
        "icon": "▶Ⅱ",
        "color": "#83e5c9",
        "steps": [
          "tap PlayPause"
        ]
      },
      {
        "label": "Next",
        "icon": "▶|",
        "color": "#b4a0ff",
        "steps": [
          "tap NextTrack"
        ]
      },
      {
        "label": "Volume down",
        "icon": "−",
        "color": "#87cbf1",
        "steps": [
          "tap VolumeDown"
        ]
      },
      {
        "label": "Mute",
        "icon": "×",
        "color": "#87cbf1",
        "steps": [
          "tap Mute"
        ]
      },
      {
        "label": "Volume up",
        "icon": "+",
        "color": "#87cbf1",
        "steps": [
          "tap VolumeUp"
        ]
      },
      {
        "label": "Stop",
        "icon": "■",
        "color": "#f0ad8c",
        "steps": [
          "tap MediaStop"
        ]
      },
      {
